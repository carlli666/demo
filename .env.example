# ============================================
# api-demo 环境变量配置模板
# ============================================
# 使用方法：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 填入你的真实配置
#   3. .env 文件已在 .gitignore 中，不会被提交
# ============================================

# 【必填】平台分配的 API 密钥
API_KEY=your_api_key_here

# 【必填】API 服务地址，例如：
#   测试环境：https://api-test.yourcompany.com
#   生产环境：https://api.yourcompany.com
API_BASE_URL=https://api.yourcompany.com

# 【可选】请求超时时间（秒），默认 30
API_TIMEOUT=30

# 【可选】日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
